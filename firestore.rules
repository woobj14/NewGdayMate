rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isStudent()  { return hasRole('student');  }
    function isTeacher()  { return hasRole('teacher');  }
    function isAdmin()    { return hasRole('admin');    }
    function isTeacherOrAdmin() { return isTeacher() || isAdmin(); }

    function isSameAcademy(academyId) {
      return isSignedIn() && getUserData().academyId == academyId;
    }

    // ── users 컬렉션 ───────────────────────────────────────
    match /users/{uid} {
      // 본인만 읽기/쓰기
      allow read:   if isOwner(uid) || isTeacherOrAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    // 관리자는 role 필드 변경 가능
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['role', 'status']));
      allow delete: if isAdmin();

      // 학습 진도 (학생 본인 + 같은 학원 선생님)
      match /progress/{lessonId} {
        allow read:  if isOwner(uid) || isTeacherOrAdmin();
        allow write: if isOwner(uid);
      }

      // 단어장 (본인만)
      match /wordbook/{wordId} {
        allow read, write: if isOwner(uid);
      }

      // 오답노트 (본인 + 담당 선생님)
      match /wrongNotes/{noteId} {
        allow read:  if isOwner(uid) || isTeacher();
        allow write: if isOwner(uid);
      }

      // 활동 로그 (본인 + 선생님 읽기)
      match /activityLog/{logId} {
        allow read:  if isOwner(uid) || isTeacherOrAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if false;  // 로그는 수정/삭제 불가
      }
    }

    // ── content 컬렉션 (학습 자료) ───────────────────────
    // 커리큘럼 (선생님만 쓰기, 같은 학원 읽기)
    match /curricula/{curriculumId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    match /content/{contentId} {
      // 같은 학원 학생/선생님 읽기
      allow read:   if isSignedIn() &&
                       isSameAcademy(resource.data.academyId);
      // 선생님/관리자만 쓰기
      allow create: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin() &&
                       (isAdmin() || resource.data.assignedBy == request.auth.uid);
      allow delete: if isAdmin() ||
                       (isTeacher() && resource.data.assignedBy == request.auth.uid);

      // 퀴즈 문항 (하위 컬렉션)
      match /quizItems/{itemId} {
        allow read:  if isSignedIn() && isSameAcademy(
                        get(/databases/$(database)/documents/content/$(contentId)).data.academyId);
        allow write: if isTeacherOrAdmin();
      }
    }

    // ── academies 컬렉션 ──────────────────────────────────
    match /academies/{academyId} {
      // 같은 학원 멤버 읽기
      allow read:   if isSignedIn() && isSameAcademy(academyId);
      // 관리자만 쓰기
      allow write:  if isAdmin();

      match /classes/{classId} {
        allow read:  if isSignedIn() && isSameAcademy(academyId);
        allow write: if isTeacherOrAdmin();

        match /assignments/{assignId} {
          allow read:  if isSignedIn() && isSameAcademy(academyId);
          allow write: if isTeacherOrAdmin();
        }
      }
    }

    // ── 공개 학원 코드 조회 (회원가입 전 검증용) ─────────────
    match /joinCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // ── quizCache 컬렉션 (Gemini 퀴즈 캐시) ──────────────────
    match /quizCache/{cacheId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update, delete: if isAdmin();
    }

        // ── leaderboards 컬렉션 ────────────────────────────────
    match /leaderboards/{classId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();  // Cloud Function이 집계
    }

    // ── messages 컬렉션 (쪽지함) ──────────────────────────
    match /messages/{messageId} {
      allow read:  if isSignedIn() &&
                      (resource.data.fromUid == request.auth.uid ||
                       resource.data.toUid   == request.auth.uid ||
                       isTeacher());
      allow create: if isSignedIn();
      allow update: if isTeacher() &&
                       resource.data.toUid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
